# Godot-generated data
.godot/
.import/

# Export output
build/
dist/
exports/
*.pck

# Source archives and normalized imports are local-only.
vendor/local/
assets/source/supplemental/

# This checkout can receive an expanded local asset drop. Keep raw source packs
# out of version control; only intentional generated/runtime outputs may be added.
assets/*
!assets/generated/
!assets/generated/**
*.import

# Local validation and environment snapshots are reproducibility evidence, not
# source-controlled project content.
artifacts/local/

# Local tooling
__pycache__/
*.py[cod]
.venv/
venv/
.env

# Editors and OS files
.vscode/
.idea/
.DS_Store
Thumbs.db

# Temporary files
*.tmp
*.bak
*.swp
